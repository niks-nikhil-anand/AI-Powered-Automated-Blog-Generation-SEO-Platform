// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FAILED
  ARCHIVED
}

/// Lifecycle of a manually-submitted blog specification. PENDING = queued
/// but not yet dispatched (the scheduler's backlog), PROCESSING = somewhere
/// in planning -> outline -> writing -> image -> quality, COMPLETED = the
/// generated blog published, FAILED = a stage gave up permanently.
enum BlogInputStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BlogInputPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Job {
  id        String    @id @default(cuid())
  queue     String
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id             String   @id @default(cuid())
  fileName       String
  bucket         String
  path           String
  publicUrl      String
  mimeType       String
  width          Int?
  height         Int?
  size           Int
  /// Difference-hash of the image, for the uniqueness check in image-worker
  /// (Hamming distance against recent assets - see workers/image-worker/quality.ts).
  imageHash      String?
  /// Which art-direction descriptor produced this image (see
  /// workers/image-worker/ai-generator.ts's STYLE_DIRECTIONS), or null for
  /// the procedural SVG fallback.
  styleDirection String?
  blogs          Blog[]   @relation("FeaturedImage")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model Blog {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String?
  content         String
  html            String
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          BlogStatus     @default(DRAFT)
  featuredImageId String?
  featuredImage   Asset?         @relation("FeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  /// One blog per submitted specification - lets writing-worker upsert on
  /// retry instead of creating a duplicate row for the same BlogInput.
  /// Nullable because a Blog could theoretically be created outside the
  /// input -> plan -> outline -> write pipeline.
  blogInputId     String?        @unique
  blogInput       BlogInput?     @relation(fields: [blogInputId], references: [id], onDelete: SetNull)
  seo             BlogSEO?
  qualityReport   QualityReport?
  aiUsage         AIUsage[]
  /// Disclosed AI authorship credit, mirrored into BlogSEO.schema's "author"
  /// field by writing-worker. Value must match workers/shared/branding.ts's
  /// AI_BYLINE - Prisma can't reference a TS constant for a column default,
  /// so the two are kept in sync by hand. See IMPLEMENTATION_PLAN.md Phase 2.7.
  byline          String         @default("Drafted with AI assistance, DevKit Market Analysis")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ContentPlan {
  id                String          @id @default(cuid())
  blogInputId       String          @unique
  blogInput         BlogInput       @relation(fields: [blogInputId], references: [id], onDelete: Cascade)
  searchIntent      String
  audience          String
  angle             String
  primaryKeyword    String
  secondaryKeywords Json
  competitorNotes   Json
  internalNotes     String?
  plannedClaims     Json?
  outline           ContentOutline?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([blogInputId])
}

model ContentOutline {
  id              String      @id @default(cuid())
  blogInputId     String      @unique
  blogInput       BlogInput   @relation(fields: [blogInputId], references: [id], onDelete: Cascade)
  planId          String      @unique
  plan            ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  metaTitle       String
  metaDescription String
  sections        Json
  faqs            Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([blogInputId])
  @@index([planId])
}

model BlogSEO {
  id              String   @id @default(cuid())
  blogId          String   @unique
  blog            Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  metaTitle       String
  metaDescription String
  canonical       String?
  keywords        Json
  schema          Json
  score           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QualityReport {
  id                  String   @id @default(cuid())
  blogId              String   @unique
  blog                Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  overallScore        Int
  seoStructure        Int
  contentCompleteness Int
  readability         Int
  contentQuality      Int
  keywordOptimization Int
  technicalSeo        Int
  formattingUx        Int
  mediaQuality        Int
  aiFactQuality       Int
  publishingReadiness Int
  /// 11th check, added on top of the original ten (see IMPLEMENTATION_PLAN.md
  /// Phase 2.5) - a real Vertex-verified claims check against
  /// BlogInput.evidenceSummary, from workers/quality-worker/factcheck.ts. Distinct
  /// from aiFactQuality above, which stays a cheap regex heuristic
  /// (AI-disclaimer/placeholder-text patterns) - this is the "actually checks
  /// facts" dimension the plan calls for.
  factVerification    Int      @default(0)
  /// Claim-level fact-check detail (ENHANCEMENT_IMPLEMENTATION_PLAN.md Task 3).
  /// JSON: { coveragePct, totalClaims, supported, uncertain, unsupported,
  /// unverifiable, claims: [{claim, verdict, confidence, note, sourceUrl?}] }.
  /// Null when the legacy sampled fact-check ran instead.
  factCheckDetail     Json?
  /// LLM editorial judge breakdown (ENHANCEMENT_IMPLEMENTATION_PLAN.md Task 4).
  /// JSON: { scores: {depth, accuracyOfTone, originality, usefulness},
  /// overall, critique, fixes: [{section, issue, fix, priority}] }.
  /// Null when the judge was disabled or its call failed (fails soft).
  judgeDetail         Json?
  passed              Boolean
  recommendation      String
  checks              Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// A manually-submitted blog specification - the single entry point of the
/// pipeline now that automated trend discovery is gone. The user fills the
/// form at /dashboard/blogs/new (or POSTs the same JSON to
/// /api/blogs/input); the row is then dispatched through
/// planning -> outline -> writing -> image -> quality -> publish.
model BlogInput {
  id    String @id @default(cuid())
  title String @unique
  slug  String @unique

  /// The raw validated submission, exactly as it arrived. Every column below
  /// is a denormalized projection of this blob, kept as real columns so the
  /// dashboard can filter/sort without unpacking JSON on every row.
  specs Json

  /// Primary keywords the article must target (BlogInput.focusKeyword is the
  /// single most important one).
  keywords          String[] @default([])
  /// LSI / supporting keywords.
  secondaryKeywords String[] @default([])
  audience          String?
  searchIntent      String?
  /// professional | casual | technical - drives the writing prompt's voice.
  tone              String?  @default("professional")
  /// Target word count for the finished article.
  contentLength     Int?     @default(2000)
  category          String?

  /// Optional pre-structured outline supplied by the user:
  /// { sections: [{ heading, intent, bullets }], faqs: [{ question, answer }] }.
  /// When present, outline-worker uses it verbatim instead of asking Vertex
  /// for a structure.
  outlineJson Json?

  metaTitle       String?
  metaDescription String?
  focusKeyword    String?

  /// Optional reference material the user supplied. Same shape as the
  /// research pipeline's old Trend.evidenceArticles (see
  /// workers/shared/evidence.ts's EvidenceArticleSchema), so the whole
  /// grounding/citation/fact-check stack keeps working for sourced inputs.
  /// Null/empty = "unsourced" mode: the evidence gates are skipped and the
  /// article is written from the user's specification alone.
  evidenceArticles Json?
  /// Human-readable digest of the sources above, used by the legacy
  /// (non-marker) citation and fact-check paths.
  evidenceSummary  String? @db.Text

  priority      BlogInputPriority @default(NORMAL)
  status        BlogInputStatus   @default(PENDING)
  /// Why the pipeline gave up, when status is FAILED.
  failureReason String?

  plan         ContentPlan?
  outline      ContentOutline?
  blog         Blog?
  workflowRuns WorkflowRun[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// When the pipeline finished with this row (published or failed).
  processedAt  DateTime?
  /// When the row was handed to the planning queue.
  dispatchedAt DateTime?

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([processedAt])
}

/// Persisted Winston output. Written by the buffered PrismaTransport in
/// workers/shared/log-transport.ts; pruned to LOG_RETENTION_DAYS.
model LogEntry {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  level         String
  worker        String?
  message       String
  stack         String?
  meta          Json?
  workflowRunId String?
  blogInputId   String?
  blogId        String?

  @@index([timestamp])
  @@index([level, timestamp])
  @@index([worker, timestamp])
}

model WorkflowRun {
  id            String          @id @default(cuid())
  blogInputId   String?
  blogInput     BlogInput?      @relation(fields: [blogInputId], references: [id], onDelete: SetNull)
  blogId        String?
  status        String          @default("RUNNING")
  currentStage  String
  failureReason String?
  attempts      WorkerAttempt[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([blogInputId])
  @@index([blogId])
}

model WorkerAttempt {
  id            String      @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  worker        String
  attempt       Int
  status        String      @default("RUNNING")
  input         Json
  output        Json?
  qualityReport Json?
  error         String?
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?

  @@index([workflowRunId, worker])
}

model AIUsage {
  id               String   @id @default(cuid())
  worker           String
  model            String
  blogId           String?
  blog             Blog?    @relation(fields: [blogId], references: [id], onDelete: SetNull)
  blogInputId      String?
  promptTokens     Int
  completionTokens Int
  /**
   * USD, computed from MODEL_PRICING at write time.
   */
  cost             Float
  /**
   * Round-trip latency of the model call, in milliseconds.
   */
  latency          Int
  createdAt        DateTime @default(now())

  @@index([blogId])
  @@index([createdAt])
  @@index([worker, createdAt])
  @@index([model, createdAt])
}

/// Small key/value store for dashboard-editable settings that previously had
/// no persistence at all (AI model per pipeline stage, daily blog goal).
/// Read/written through workers/shared/settings.ts by both the Next.js app
/// and the worker processes, so the two never disagree on a key's spelling.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
