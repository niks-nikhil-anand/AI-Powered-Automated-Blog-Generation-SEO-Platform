# Dockerfile for the standalone BullMQ workers (research-worker, writing-worker).
# Separate from the root Dockerfile because workers run via `tsx` against
# source .ts files instead of a Next.js standalone build.
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

FROM base AS deps
COPY package.json package-lock.json ./
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN npm ci

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npx prisma generate

# Overridden per-service by docker-compose.yml (`command:`), e.g.:
#   node_modules/.bin/tsx workers/research-worker/index.ts
#   node_modules/.bin/tsx workers/writing-worker/index.ts
CMD ["node_modules/.bin/tsx", "workers/start.ts"]
