FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci
# Copy only application inputs; never copy runtime .env files or credentials.
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY workers ./workers
COPY docker/worker-entrypoint.sh ./docker/worker-entrypoint.sh
COPY next.config.ts tsconfig.json postcss.config.mjs ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate && npm run build
RUN mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
# Workers and Prisma migrations use the same image as the frontend.
COPY --from=build --chown=node:node /app /app
RUN chmod +x /app/docker/worker-entrypoint.sh
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
USER node
EXPOSE 3000
ENTRYPOINT ["/app/docker/worker-entrypoint.sh"]
CMD ["node", ".next/standalone/server.js"]
